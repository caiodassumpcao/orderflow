{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caiodassumpcao/orderflow/blob/main/docs/events/schemas/order-created.v1.schema.json",
  "title": "OrderCreated (v1) — payload",
  "description": "Pedido criado, aguardando reserva de estoque. Valores monetários são strings decimais com duas casas.",
  "type": "object",
  "required": ["orderId", "customerId", "currency", "total", "items"],
  "additionalProperties": false,
  "properties": {
    "orderId": { "$ref": "#/$defs/uuid" },
    "customerId": { "type": "string", "pattern": "^[A-Za-z0-9._:@-]{1,64}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "total": { "$ref": "#/$defs/money" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sku", "quantity", "unitPrice"],
        "additionalProperties": false,
        "properties": {
          "sku": { "$ref": "#/$defs/sku" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "unitPrice": { "$ref": "#/$defs/money" }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$" },
    "money": { "type": "string", "pattern": "^\\d{1,12}\\.\\d{2}$" }
  }
}
