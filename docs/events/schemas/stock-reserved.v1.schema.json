{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caiodassumpcao/orderflow/blob/main/docs/events/schemas/stock-reserved.v1.schema.json",
  "title": "StockReserved (v1) — payload",
  "description": "Todos os itens do pedido foram reservados ao preço de catálogo.",
  "type": "object",
  "required": ["orderId", "items"],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
