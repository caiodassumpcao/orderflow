{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caiodassumpcao/orderflow/blob/main/docs/events/schemas/order-confirmed.v1.schema.json",
  "title": "OrderConfirmed (v1) — payload",
  "description": "Pedido confirmado depois da reserva de estoque.",
  "type": "object",
  "required": ["orderId"],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
