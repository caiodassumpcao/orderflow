# Copie para `.env` e ajuste os valores. `.env` é ignorado pelo Git.
# Nunca use estes placeholders fora do ambiente de desenvolvimento local.

# --- PostgreSQL ---
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_UI_PORT=8081

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Senhas dos usuários de desenvolvimento importados no realm `orderflow`
ORDERFLOW_DEV_USER_PASSWORD=change-me-dev-user
ORDERFLOW_DEV_ADMIN_PASSWORD=change-me-dev-admin

# --- Backend (lidas pelo Spring Boot) ---
# No perfil `dev`, datasource, Kafka e issuer são derivados das variáveis acima
# (POSTGRES_*, KAFKA_PORT, KEYCLOAK_PORT). Fora de dev, defina explicitamente:
# DB_URL=jdbc:postgresql://<host>:5432/orderflow
# DB_USERNAME=
# DB_PASSWORD=
# KAFKA_BOOTSTRAP_SERVERS=<host>:9092
# KAFKA_REPLICATION_FACTOR=3          # réplicas dos tópicos criados pela aplicação
# OAUTH2_ISSUER_URI=https://<keycloak>/realms/orderflow
# OAUTH2_AUTHORIZED_PARTIES=orderflow-spa  # clientes (azp) cujos tokens a API aceita
# CORS_ALLOWED_ORIGINS=https://<spa>
SERVER_PORT=8080
