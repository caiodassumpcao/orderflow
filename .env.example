# Copie para `.env` e ajuste os valores. `.env` é ignorado pelo Git.
# Nunca use estes placeholders fora do ambiente de desenvolvimento local.

# --- PostgreSQL ---
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_UI_PORT=8081

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Senhas dos usuários de desenvolvimento importados no realm `orderflow`
ORDERFLOW_DEV_USER_PASSWORD=change-me-dev-user
ORDERFLOW_DEV_ADMIN_PASSWORD=change-me-dev-admin

# --- Backend (lidas pelo Spring Boot) ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/orderflow
DB_USERNAME=orderflow
DB_PASSWORD=change-me-postgres
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OAUTH2_ISSUER_URI=http://localhost:8180/realms/orderflow
CORS_ALLOWED_ORIGINS=http://localhost:4200
