# Servidor da SPA (imagem nginx-unprivileged: escuta em 8080, sem root).
# Template: na subida do container, o entrypoint da imagem substitui as variáveis ORDERFLOW_*
# (NGINX_ENVSUBST_FILTER) e grava o resultado em /etc/nginx/conf.d/default.conf.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Headers de segurança (repetidos nos blocos com add_header, que não herdam). connect-src libera
    # só a API e o realm OIDC (descoberta, JWKS, token); a barra final casa todos os caminhos do realm.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${ORDERFLOW_API_URL} ${ORDERFLOW_OIDC_AUTHORITY}/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Configuração de runtime lida pela SPA antes do bootstrap (ver src/app/core/config).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        return 200 '{"apiUrl":"${ORDERFLOW_API_URL}","oidc":{"authority":"${ORDERFLOW_OIDC_AUTHORITY}","clientId":"${ORDERFLOW_OIDC_CLIENT_ID}"}}';
    }

    # Arquivos com hash no nome: cache longo
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri =404;
    }

    # Rotas da SPA caem no index.html, que nunca é cacheado
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
